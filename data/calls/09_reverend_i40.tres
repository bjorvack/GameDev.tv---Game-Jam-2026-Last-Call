[ext_resource type="Script" uid="uid://cnn3ealt34uvp" path="res://scripts/dialogue_line.gd" id="2_dline"]

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
text = "(Static. A trucker grabs the phone, runs out, flags Daniel down.)"
duration = 4.0

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "(distant, breathless) Tell the Reverend — tell him I'm coming."
duration = 4.0

[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
speaker = "???"
text = "Hello?"
duration = 1.5

[sub_resource type="Resource" id="generic_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "No, no — the truck stop, operator! Marker 88!"
duration = 3.5

[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Operator. I need to reach Daniel Hayes — he's on the highway."

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Try the truck stop payphone at marker 88."
duration = 3.5

[sub_resource type="Resource" id="opening_2"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Tell him his mother's alive. They're taking her to County General."
duration = 4.5

[sub_resource type="Resource" id="timer_0"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "(Lord forgive us.)"
duration = 3.0

[sub_resource type="Resource" id="wrong_hospital_0"]
script = ExtResource("2_dline")
speaker = "Nurse"
text = "County General, please hold —"

[sub_resource type="Resource" id="wrong_hospital_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "No — not yet — he needs to know FIRST."
duration = 3.5

[resource]
script = ExtResource("1_calldata")
caller_name = "Reverend Carter"
opening = Array[ExtResource("2_dline")]([SubResource("opening_0"), SubResource("opening_1"), SubResource("opening_2")])
