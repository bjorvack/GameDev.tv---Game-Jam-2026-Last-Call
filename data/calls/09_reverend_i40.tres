[ext_resource type="Script" uid="uid://dxbl61tligon7" path="res://scripts/call_data.gd" id="1_calldata"]
[ext_resource type="Script" uid="uid://cnn3ealt34uvp" path="res://scripts/dialogue_line.gd" id="2_dline"]
[ext_resource type="Texture2D" uid="uid://djxt48wvhl80x" path="res://art/portraits/reverend.png" id="3_portrait_0"]
[ext_resource type="Texture2D" uid="uid://bnjqhn1j78wpa" path="res://art/portraits/trucker.png" id="3_portrait_1"]
[ext_resource type="Texture2D" uid="uid://5h42femxk4di" path="res://art/portraits/daniel.png" id="3_portrait_2"]
[ext_resource type="Texture2D" uid="uid://cl1e4w5jgcnci" path="res://art/portraits/unknown.png" id="3_portrait_3"]
[ext_resource type="Texture2D" uid="uid://cnjf2igh8v1so" path="res://art/portraits/nurse.png" id="3_portrait_4"]

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
speaker = "Trucker"
text = "Yeah? Hello?"
portrait = ExtResource("3_portrait_1")
duration = 2.0

[sub_resource type="Resource" id="connected_intro"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Son — Reverend Carter, Mayfield. Need your help, quick."
portrait = ExtResource("3_portrait_0")
duration = 3.0

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "A young man's coming through east any minute — dark blue sedan, Greensboro plate. Flag him down."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[sub_resource type="Resource" id="connected_1b"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "His mother's alive. They've got her at County General."
portrait = ExtResource("3_portrait_0")
duration = 3.5

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Trucker"
text = "On it, Reverend."
portrait = ExtResource("3_portrait_1")
duration = 2.0

[sub_resource type="Resource" id="connected_3"]
script = ExtResource("2_dline")
text = "(The phone bangs against the booth glass. Diesel. Footsteps in the cold.)"
duration = 4.0

[sub_resource type="Resource" id="connected_4"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "(distant, breathless) Tell the Reverend — tell him I'm coming."
portrait = ExtResource("3_portrait_2")
duration = 4.0

[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
speaker = "???"
text = "Hello?"
portrait = ExtResource("3_portrait_3")
duration = 1.5

[sub_resource type="Resource" id="generic_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "No, no — the truck stop, operator! Marker 88!"
portrait = ExtResource("3_portrait_0")
duration = 3.5

[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Operator. I need to reach Daniel Hayes — he's on the highway."
portrait = ExtResource("3_portrait_0")

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Doc said his last call came from the diesel stop at marker 88 — that was thirty minutes back. Try the truck stop payphone there."
portrait = ExtResource("3_portrait_0")
duration = 5.0

[sub_resource type="Resource" id="opening_2"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Whoever picks up, tell them to flag him down. Tell him his mother's alive. They're taking her to County General."
portrait = ExtResource("3_portrait_0")
duration = 5.0

[sub_resource type="Resource" id="thought_0"]
script = ExtResource("2_dline")
text = "The line went warm. He knows now."
duration = 3.5

[sub_resource type="Resource" id="thought_1"]
script = ExtResource("2_dline")
text = "One more call before the board goes dark."
duration = 3.5

[sub_resource type="Resource" id="timer_0"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "(Lord forgive us.)"
portrait = ExtResource("3_portrait_0")
duration = 3.0

[sub_resource type="Resource" id="wrong_hospital_0"]
script = ExtResource("2_dline")
speaker = "Nurse"
text = "County General, please hold —"
portrait = ExtResource("3_portrait_4")

[sub_resource type="Resource" id="wrong_hospital_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "No — not yet — he needs to know FIRST."
portrait = ExtResource("3_portrait_0")
duration = 3.5

[resource]
script = ExtResource("1_calldata")
caller_name = "Reverend Carter"
caller_portrait = ExtResource("3_portrait_0")
opening = Array[ExtResource("2_dline")]([SubResource("opening_0"), SubResource("opening_1"), SubResource("opening_2")])
caller_socket = &"reverend"
correct_socket = &"i40"
connected_dialogue = Array[ExtResource("2_dline")]([SubResource("connected_0"), SubResource("connected_intro"), SubResource("connected_1"), SubResource("connected_1b"), SubResource("connected_2"), SubResource("connected_3"), SubResource("connected_4")])
wrong_responses = {
&"hospital": Array[Resource]([SubResource("wrong_hospital_0"), SubResource("wrong_hospital_1")])
}
generic_wrong_response = Array[ExtResource("2_dline")]([SubResource("generic_0"), SubResource("generic_1")])
time_limit = 18.0
timer_expired = Array[ExtResource("2_dline")]([SubResource("timer_0")])
sockets_lit = Array[StringName]([&"hayes", &"doc", &"sheriff", &"reverend", &"patty", &"cole", &"i40"])
pivotal = true
operator_thought = Array[ExtResource("2_dline")]([SubResource("thought_0"), SubResource("thought_1")])
