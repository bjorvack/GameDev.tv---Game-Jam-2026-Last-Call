[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Sheriff Briggs"
text = "Operator — Briggs. Get me Patty's, quick."
portrait = ExtResource("3_portrait_0")
duration = 3.0

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Sheriff Briggs"
text = "Henley called in about a unit on Vine. Need to ask Patty if Margaret was in this morning."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[resource]
script = ExtResource("1_calldata")
