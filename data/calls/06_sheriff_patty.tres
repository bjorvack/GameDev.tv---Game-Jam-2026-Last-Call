[sub_resource type="Resource" id="connected_greet"]
script = ExtResource("2_dline")
speaker = "Sheriff Briggs"
text = "Patty? Briggs. Margaret Hayes been in today? Henley spotted a unit on Vine."
portrait = ExtResource("3_portrait_0")
duration = 4.0

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "She came in yesterday morning. Said she was tired."
portrait = ExtResource("3_portrait_1")
duration = 3.5

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Hasn't been in today, Sheriff."
portrait = ExtResource("3_portrait_1")
duration = 3.0

[sub_resource type="Resource" id="connected_pause"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "…"
portrait = ExtResource("3_portrait_1")
duration = 2.0

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Oh god."
