[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
speaker = "???"
text = "Hello?"
portrait = ExtResource("3_portrait_2")
duration = 1.5

[sub_resource type="Resource" id="generic_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Wrong line — apologies. Please, hurry."
portrait = ExtResource("3_portrait_0")
duration = 2.0

[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Operator — Reverend Carter, from the Chapel."
portrait = ExtResource("3_portrait_0")

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Old Mr. Bray's taken a turn — bad. Put me through to Doc Wheeler, quickly."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[sub_resource type="Resource" id="timer_0"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Doc — anyone — Lord have mercy. He's gone still."
portrait = ExtResource("3_portrait_0")
duration = 4.0

[sub_resource type="Resource" id="wrong_bray_0"]
script = ExtResource("2_dline")
speaker = "Mrs. Bray"
