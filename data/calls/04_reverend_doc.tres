duration = 1.8

[sub_resource type="Resource" id="wrong_bray_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Mrs. Bray — wrong line, dear. Walter's fine. Sorry to wake you."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[sub_resource type="Resource" id="wrong_hospital_0"]
script = ExtResource("2_dline")
speaker = "Nurse"
text = "County General."
portrait = ExtResource("3_portrait_3")
duration = 1.8

[sub_resource type="Resource" id="wrong_hospital_1"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "No — Doc Wheeler. He needs Doc, not the hospital."
portrait = ExtResource("3_portrait_0")
duration = 3.5

[resource]
script = ExtResource("1_calldata")
