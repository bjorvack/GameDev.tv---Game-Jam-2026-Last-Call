[sub_resource type="Resource" id="connected_explain"]
script = ExtResource("2_dline")
speaker = "Reverend Carter"
text = "Doc — Mr. Bray's taken a turn. We're at the Chapel."
portrait = ExtResource("3_portrait_0")
duration = 3.5

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "On my way, Reverend."
