speaker = "Daniel"
text = "Mom? Mom, it's Daniel. Pick up."
duration = 3.0

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "She always answers."
duration = 2.5

[sub_resource type="Resource" id="connected_3"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "I'll try again, operator. Thanks."

[sub_resource type="Resource" id="wrong_doc_0"]
