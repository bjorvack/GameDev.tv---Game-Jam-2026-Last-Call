[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
text = "(Ring. Ring. Ring. No answer.)"
portrait = ExtResource("3_portrait_4")
duration = 3.5

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "She… she must've gone to the market."
voice_text = "She, she must've gone to the market."
portrait = ExtResource("3_portrait_0")
duration = 3.0
mood = &"anxious"

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "I'll try again from the next stop. Thanks, operator."
portrait = ExtResource("3_portrait_0")
mood = &"anxious"

[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
speaker = "???"
text = "Hello?"
portrait = ExtResource("3_portrait_1")
duration = 1.5

[sub_resource type="Resource" id="generic_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Sorry — wrong number."
voice_text = "Sorry, wrong number."
portrait = ExtResource("3_portrait_0")
duration = 2.0

[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Operator — please."
voice_text = "Operator — please!"
portrait = ExtResource("3_portrait_0")
mood = &"anxious"

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "I need to reach Mrs. Hayes on 7th and Vine — my mother. She missed her morning call and I've been on the road all day."
portrait = ExtResource("3_portrait_0")
duration = 5.5

[sub_resource type="Resource" id="opening_2"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "I'm two hours out on Highway 40."
portrait = ExtResource("3_portrait_0")

[sub_resource type="Resource" id="thought_0"]
script = ExtResource("2_dline")
text = "Margaret Hayes. Her line never rings out like that."
duration = 3.5

[sub_resource type="Resource" id="thought_1"]
script = ExtResource("2_dline")
text = "She always picks up by the third ring."
duration = 3.5

[sub_resource type="Resource" id="timer_0"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Operator? Operator, please — I'll call back."
voice_text = "Operator?! Operator, PLEASE. I'll call back."
portrait = ExtResource("3_portrait_0")
duration = 3.5
mood = &"anxious"

[sub_resource type="Resource" id="thought_fail_0"]
script = ExtResource("2_dline")
text = "He hung up before I could even try her line."
duration = 3.5

[sub_resource type="Resource" id="thought_fail_1"]
script = ExtResource("2_dline")
text = "I hope he calls back from the next stop."
duration = 3.5

[sub_resource type="Resource" id="wrong_doc_0"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Doc Wheeler's office."
portrait = ExtResource("3_portrait_2")
duration = 2.0

[sub_resource type="Resource" id="wrong_doc_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Doc — sorry, wrong line. I'm trying to reach Mom."
portrait = ExtResource("3_portrait_0")
duration = 3.0

[sub_resource type="Resource" id="wrong_patty_0"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Patty's Diner."
portrait = ExtResource("3_portrait_3")
duration = 1.8

[sub_resource type="Resource" id="wrong_patty_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Patty — wrong line, sorry. Have you seen Mom today?"
portrait = ExtResource("3_portrait_0")

[sub_resource type="Resource" id="wrong_patty_2"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Not today, hon. Sorry."
portrait = ExtResource("3_portrait_3")
duration = 2.0

