[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "I need to reach Mrs. Hayes on 7th and Vine. She's my mother — she didn't answer her morning call."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[sub_resource type="Resource" id="opening_2"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "I'm two hours out on Highway 40."
portrait = ExtResource("3_portrait_0")
duration = 2.5

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
speaker = ""
text = "(Ring. Ring. Ring. No answer.)"
portrait = ExtResource("3_portrait_4")
duration = 3.5

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "She… she must've gone to the market."
portrait = ExtResource("3_portrait_0")
duration = 3.0

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "I'll try again later. Thanks."
portrait = ExtResource("3_portrait_0")
duration = 2.5

[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
