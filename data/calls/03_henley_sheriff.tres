duration = 1.5

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "Sheriff, there's an ambulance on Vine—"
portrait = ExtResource("3_portrait_0")

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Sheriff Briggs"
text = "I know, Mrs. Henley. We're on it. Stay inside."
portrait = ExtResource("3_portrait_1")
duration = 3.5

[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
speaker = "???"
text = "Hello?"
portrait = ExtResource("3_portrait_2")
duration = 1.5

[sub_resource type="Resource" id="generic_1"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "Wrong line — sorry. Try the sheriff!"
portrait = ExtResource("3_portrait_0")
duration = 2.0

[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "Operator? It's Henley on 8th — quick now."
portrait = ExtResource("3_portrait_0")

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "There's an ambulance on Vine. Two streets over. Been there ten minutes."
portrait = ExtResource("3_portrait_0")
duration = 4.0

[sub_resource type="Resource" id="opening_2"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "Put me through to the sheriff. Something's not right."
portrait = ExtResource("3_portrait_0")
duration = 3.5

[sub_resource type="Resource" id="wrong_hayes_0"]
script = ExtResource("2_dline")
text = "(Ring. Ring. No answer.)"
duration = 2.0

[sub_resource type="Resource" id="wrong_hayes_1"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "Operator — that wasn't the Hayes place, was it? Try the sheriff. Please."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[resource]
script = ExtResource("1_calldata")
