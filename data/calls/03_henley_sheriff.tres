[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "Operator, this is Henley over on 8th."

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "There's been an ambulance sitting two streets over near Vine for ten minutes."
duration = 4.0

[sub_resource type="Resource" id="opening_2"]
script = ExtResource("2_dline")
speaker = "Mrs. Henley"
text = "Connect me to the sheriff, would you? Something's not right."
duration = 3.5

[sub_resource type="Resource" id="wrong_hayes_0"]
