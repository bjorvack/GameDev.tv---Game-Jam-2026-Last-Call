[ext_resource type="Script" uid="uid://cnn3ealt34uvp" path="res://scripts/dialogue_line.gd" id="2_dline"]

[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Mornin', operator — Patty here."

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Put me through to Cole's Garage, would you? Got a spot of trouble down at the diner."
duration = 3.5

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
speaker = "Cole"
text = "Cole's Garage."
duration = 1.8

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Cole, it's Patty. Delivery truck won't crank and I've got a freezer half-thawed."
duration = 3.5

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Cole"
text = "Yep, I'll be over in twenty."
duration = 2.5

[sub_resource type="Resource" id="connected_3"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Bless you, Cole."
duration = 2.0

[sub_resource type="Resource" id="wrong_hayes_0"]
script = ExtResource("2_dline")
text = "(ringing… no answer)"

[sub_resource type="Resource" id="wrong_hayes_1"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "She must not be in. Try someone else, operator."
duration = 3.0

[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
speaker = "???"
text = "Hello?"
duration = 1.5

[sub_resource type="Resource" id="generic_1"]
script = ExtResource("2_dline")
speaker = "Patty"
text = "Sorry — wrong number."
duration = 2.0

[resource]
script = ExtResource("1_calldata")
caller_name = "Patty"
opening = Array[ExtResource("2_dline")]([SubResource("opening_0"), SubResource("opening_1")])
correct_socket = &"cole"
connected_dialogue = Array[ExtResource("2_dline")]([SubResource("connected_0"), SubResource("connected_1"), SubResource("connected_2"), SubResource("connected_3")])
wrong_responses = {
&"hayes": Array[Resource]([SubResource("wrong_hayes_0"), SubResource("wrong_hayes_1")])
}
