[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Operator, it's Daniel Hayes. Pulled off at the diesel stop, marker 88."
portrait = ExtResource("3_portrait_0")
duration = 3.5

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Try Mom again — 7th and Vine. Please."
portrait = ExtResource("3_portrait_0")
duration = 3.0

[sub_resource type="Resource" id="first_leg_0"]
script = ExtResource("2_dline")
text = "(Ring. Ring. Ring. No answer.)"
portrait = ExtResource("3_portrait_4")
duration = 3.5

[sub_resource type="Resource" id="first_leg_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Damn. Damn it."
portrait = ExtResource("3_portrait_0")
duration = 2.0

[sub_resource type="Resource" id="first_leg_2"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Operator — try Doc Wheeler. She had a check-up Thursday. He might know."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[sub_resource type="Resource" id="connected_pickup"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Wheeler."
portrait = ExtResource("3_portrait_1")
duration = 1.5

[sub_resource type="Resource" id="connected_explain"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Doc — it's Daniel. Mom's not answering. I'm on Hwy 40, two hours out. Did she—"
portrait = ExtResource("3_portrait_0")
duration = 4.5

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Daniel… your mother came in Thursday with chest pains."
portrait = ExtResource("3_portrait_1")
duration = 4.0

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "I told her to call me at the first sign it came back."
portrait = ExtResource("3_portrait_1")
duration = 3.5

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Son — get home. Fast."
portrait = ExtResource("3_portrait_1")

[sub_resource type="Resource" id="wrong_doc_0"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Wheeler."
portrait = ExtResource("3_portrait_1")
duration = 1.5

[sub_resource type="Resource" id="wrong_doc_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Doc — sorry, wrong line. Operator, I asked for Mom. 7th and Vine, please."
portrait = ExtResource("3_portrait_0")
duration = 4.5

[sub_resource type="Resource" id="wrong_sheriff_0"]
script = ExtResource("2_dline")
speaker = "Sheriff Briggs"
text = "Sheriff's office."
portrait = ExtResource("3_portrait_3")
duration = 1.8

[sub_resource type="Resource" id="wrong_sheriff_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Sheriff — wrong line, sorry. I'm trying Mom."
portrait = ExtResource("3_portrait_0")
duration = 3.0

[sub_resource type="Resource" id="wrong_sheriff_2"]
script = ExtResource("2_dline")
speaker = "Sheriff Briggs"
text = "…Son, who am I talking to?"
portrait = ExtResource("3_portrait_3")

[sub_resource type="Resource" id="generic_0"]
script = ExtResource("2_dline")
speaker = "???"
text = "Hello?"
portrait = ExtResource("3_portrait_2")
duration = 1.5

[sub_resource type="Resource" id="generic_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Sorry — wrong line."
portrait = ExtResource("3_portrait_0")
duration = 2.0

[sub_resource type="Resource" id="thought_0"]
script = ExtResource("2_dline")
text = "Doc didn't say it. But I heard it."
duration = 3.5

[sub_resource type="Resource" id="thought_1"]
script = ExtResource("2_dline")
text = "Margaret's running out of time."
duration = 3.5

[sub_resource type="Resource" id="timer_0"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Operator? I'm losing signal. Try again — please."
portrait = ExtResource("3_portrait_0")
duration = 3.5

