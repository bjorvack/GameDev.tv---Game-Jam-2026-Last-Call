text = "Sorry — wrong number."
duration = 2.0

[sub_resource type="Resource" id="timer_0"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Operator? I'm losing signal. Try again — please."
duration = 3.5

[sub_resource type="Resource" id="wrong_hayes_0"]
