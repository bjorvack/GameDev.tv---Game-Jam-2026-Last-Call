[sub_resource type="Resource" id="opening_0"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Operator, it's Daniel Hayes again."
duration = 2.5

[sub_resource type="Resource" id="opening_1"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Still no answer at Mom's."
duration = 2.0

[sub_resource type="Resource" id="opening_2"]
script = ExtResource("2_dline")
speaker = "Daniel"
text = "Could you try Doc Wheeler? She had a check-up Thursday — maybe he knows if she went somewhere."
duration = 4.5

[sub_resource type="Resource" id="connected_0"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Wheeler."
duration = 1.5

[sub_resource type="Resource" id="connected_1"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Daniel… your mother came in Thursday with chest pains."
duration = 4.0

[sub_resource type="Resource" id="connected_2"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "I told her to call me at the first sign it came back."
duration = 3.5

[sub_resource type="Resource" id="connected_3"]
script = ExtResource("2_dline")
speaker = "Doc Wheeler"
text = "Son — drive faster."
duration = 2.5

[sub_resource type="Resource" id="generic_0"]
