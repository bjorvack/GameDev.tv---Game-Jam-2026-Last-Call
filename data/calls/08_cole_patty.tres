[gd_resource type="Resource" script_class="CallData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/call_data.gd" id="1_calldata"]

[resource]
script = ExtResource("1_calldata")
caller_name = "Cole"
request_text = "Patty, it's Cole. Truck stalled out near 7th and Vine — there's two units and a chaplain at Margaret's place. Anyone heard from Daniel?"
correct_socket = &"patty"
post_connect_lines = Array[String]([
"Patty: \"He's on I-40. Lord, he doesn't know yet.\""
])
sockets_lit = Array[StringName]([])
pivotal = false
