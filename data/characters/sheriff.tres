[resource]
script = ExtResource("1_char")
name = "Sheriff Briggs"
aliases = Array[StringName]([&"Briggs", &"Sheriff"])
gender = "male"
age = "late 40s"
speaking_tone = "authoritative, tired, clipped — answers the phone with one word ('Briggs.')"
description = "Mayfield's sheriff. Gets the first warning that something is wrong (call 3 — Mrs. Henley spots the ambulance) and is the one piecing together Margaret Hayes's situation through the town. By call 6 he's checking with Patty whether Margaret has been in, and the moment Patty says 'Hasn't been in today' he goes silent for a full beat — that's when he knows."
portrait = ExtResource("3_portrait")
voices = Array[Resource]([SubResource("voice_default")])
