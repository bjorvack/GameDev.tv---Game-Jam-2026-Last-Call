[resource]
script = ExtResource("1_char")
name = "Daniel"
aliases = Array[StringName]([&"Daniel Hayes"])
gender = "male"
age = "mid 30s"
speaking_tone = "tired warmth, mild Southern, becomes brittle under stress"
description = "Margaret Hayes's son. Travelling salesman, driving home down Highway 40 from a sales swing. Calls his mother every morning; today she didn't answer. Across the run he becomes the story's emotional spine — the early lines are his routine son's-on-the-road check-ins, the late lines (calls 5, 7, 10) are him realising something is very wrong. Note: call 10's '(Daniel's breath catches…)' is a non-verbal sound and is handled as an ordinary SFX rather than a voice reference here."
portrait = ExtResource("3_portrait")