[resource]
script = ExtResource("1_char")
name = "Reverend Carter"
aliases = Array[StringName]([&"Carter", &"Reverend"])
gender = "male"
age = "early 50s"
speaking_tone = "pastoral calm, deliberate, low register, knows when to drop into stillness"
description = "The Chapel's reverend. Starts as the one asking for help (call 4 — Mr. Bray has taken a turn), turns into Daniel's quiet rescuer later in the run: he's the one who runs to Margaret's house in call 7 and who flags down a trucker on Highway 40 in call 9 to find Daniel before the worst news can. Calm under pressure. Never speaks fast."
portrait = ExtResource("3_portrait")
voices = Array[Resource]([SubResource("voice_default")])
