transcript = "I fear darkness hunts us. Use what you've learned and stay the course."
notes = "Sourced from a CC-licensed voice acting clip on Pixabay (\"originalvo medieval gamer voice — darkness hunts us\"). 5.76s, baritone dramatic delivery — natural fit for Doc's weary professional register. Mood handled at generation time via --instruct directive."

[resource]
script = ExtResource("1_char")
name = "Doc Wheeler"
aliases = Array[StringName]([&"Doc", &"Wheeler"])
gender = "male"
age = "early 60s"
speaking_tone = "weary, terse, kindly, never raises his voice"
description = "Mayfield's only physician. Answers the phone with his surname and one syllable. Has known Margaret Hayes for decades and saw her last week for chest pains; carries the weight of that visit. In call 5 he's the one who tells Daniel his mother's situation has turned — speaks slowly, picks every word."
portrait = ExtResource("3_portrait")
voices = Array[Resource]([SubResource("voice_default")])
