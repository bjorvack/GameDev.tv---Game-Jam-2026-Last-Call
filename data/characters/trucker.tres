script = ExtResource("1_char")
name = "Trucker"
aliases = Array[StringName]([])
gender = "male"
age = "40s"
speaking_tone = "rough, road-weary, plain-spoken, helpful when asked"
description = "Anonymous long-haul driver, picks up at the Highway 40 truck-stop phone booth when the Reverend places the long-shot call in call 9. Doesn't know any of these people. Hears the situation, agrees to help — flags down Daniel's car and tells him to turn around. Speaks in short useful sentences. Last we hear of him is the phone hitting the booth glass as he runs out."
