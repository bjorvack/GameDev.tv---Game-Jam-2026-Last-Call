[sub_resource type="Resource" id="voice_default"]
script = ExtResource("2_vref")
audio = ExtResource("4_voice_default")
transcript = "They run, they laugh. I see the glow shining in their eyes. Not like hers."
notes = "Sourced from a CC-licensed short-film monologue on freesound (\"shortfilm-voice-56795\"). The opening 8s of a dramatic grief monologue — gruff, contemplative male delivery. Pixabay/Freesound CC0-equivalent license."

[resource]
script = ExtResource("1_char")
name = "Cole"
gender = "male"
age = "early 50s"
speaking_tone = "gruff, economical, blue-collar"
description = "Runs Cole's Garage just off the main road. Answers the phone with one word and never wastes a second. Has known Patty since high school and would drive across the county for her, but you'd never hear him say so. Speaks in short clipped sentences, dry humour buried under a workshop accent."
portrait = ExtResource("3_portrait")
voices = Array[ExtResource("2_vref")]([SubResource("voice_default")])
