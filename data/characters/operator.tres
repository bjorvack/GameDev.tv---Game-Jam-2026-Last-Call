[resource]
script = ExtResource("1_char")
name = "Operator"
aliases = Array[StringName]([&""])
gender = "female"
age = "30s"
speaking_tone = "reflective, hushed, present-tense inner thinking"
description = "The player character. Mayfield's night-shift switchboard operator. Her voice never appears on the line — she speaks only in the inter-call monologues that play over the black overlay between rings. Those lines are her internal noticing: a missing connection, a familiar caller's silence, the slow assembly of what she's piecing together. The empty-string speaker on DialogueLines is the convention the call data uses for these monologues, hence the alias."
portrait = null
voices = Array[Resource]([SubResource("voice_default")])
